import assert from 'node:assert/strict';
import fs from 'node:fs';
import path from 'node:path';
import {createRequire} from 'node:module';
import {pathToFileURL} from 'node:url';
const require=createRequire(import.meta.url);
const plugin=require('./index.cjs');
const native=process.argv[2];
const evidence=path.resolve(process.argv[3]||'.omo/evidence/gift8-plugin');
const {buildReplyPromptEnvelope}=await import(pathToFileURL(path.join(native,'src/auto-reply/reply/prompt-prelude.ts')).href);
const {resolveInternalEventPromptBody}=await import(pathToFileURL(path.join(native,'src/agents/internal-events.ts')).href);
const {createHookRunner}=await import(pathToFileURL(path.join(native,'src/plugins/hooks.ts')).href);
const {createEmptyPluginRegistry}=await import(pathToFileURL(path.join(native,'src/plugins/registry.ts')).href);
const prompt='Return current gift cards for 21951,23345,11125,11141,20209.';
const envelope=buildReplyPromptEnvelope({ctx:{},sessionCtx:{},baseBody:prompt,hasUserBody:true,inboundUserContext:'Untrusted sender metadata fixture',isBareSessionReset:false,startupAction:'new'});
assert.equal(envelope.queuedBody,prompt);
assert.equal(envelope.prefixedCommandBody,prompt);
const hookPrompt=resolveInternalEventPromptBody(envelope.queuedBody,undefined,undefined);
assert.equal(hookPrompt,prompt);
const root=fs.mkdtempSync(path.join(evidence,'native-'));
const m={id:'native-binding',sessionKey:'native-session',arm:'tool',prompt_sha256:plugin.sha(prompt),created_ms:Date.now(),ids:plugin.IDS,protocol:'gift8-v1',plugin_sha256:plugin.pluginSha256()};
fs.mkdirSync(path.join(root,'manifests'));fs.writeFileSync(path.join(root,'manifests',m.id+'.json'),JSON.stringify(m));
const registry=createEmptyPluginRegistry();
let factory;
plugin.register({pluginConfig:{campaignRoot:root},registerTool(fn){factory=fn},on(hookName,handler,opts={}){registry.typedHooks.push({pluginId:'gift8',hookName,handler,source:'native-fixture',...opts});}});
const runner=createHookRunner(registry);
const result=await runner.runBeforePromptBuild({prompt:hookPrompt,messages:[]},{runId:m.id,sessionKey:m.sessionKey});
assert.equal(result.systemPrompt,plugin.SYSTEM_PROMPT);assert.deepEqual(result.toolsAllow,['gift_lookup']);assert.equal(factory({sessionKey:m.sessionKey}).name,'gift_lookup');
const report={passed:true,provider_sends:0,native_version:JSON.parse(fs.readFileSync(path.join(native,'package.json'),'utf8')).version,prompt_sha256:plugin.sha(prompt),plugin_sha256:plugin.pluginSha256(),prompt_preserved:true,registered_native_hook_result:result,root};
fs.writeFileSync(path.join(evidence,'native-report.json'),JSON.stringify(report,null,2));console.log(JSON.stringify(report,null,2));
